<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <components>
        <flow-layout direction="horizontal"> <!--Root-->
            <children>
                <flow-layout direction="horizontal" id="emblem@badgecase"> <!--Emblem Container-->
                    <children> </children>
                    <positioning type="layout">10,10</positioning>
                    <sizing>
                        <vertical method="fixed">117</vertical>
                        <horizontal method="fixed">108</horizontal>
                    </sizing>
                    <margins>
                        <top>86</top>
                    </margins>
                    <vertical-alignment>center</vertical-alignment>
                    <horizontal-alignment>center</horizontal-alignment>
                </flow-layout>
                <flow-layout direction="vertical"> <!--Inventory Stuff-->
                    <children>
                        <flow-layout direction="horizontal" id="layout.inventory@badgecase"> <!--Badge Case-->
                            <children>
                                <texture texture="betterbadges:textures/gui/badgecase/badge_case.png"
                                         texture-width="256" texture-height="256"
                                         region-width="176" region-height="95">
                                </texture>
                                <flow-layout direction="horizontal" id="league.navigation@badgecase"> <!-- Top Badge Case -->
                                    <children> </children>
                                    <positioning type="relative">50,5</positioning>
                                    <vertical-alignment>center</vertical-alignment>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <gap>5</gap>
                                </flow-layout>
                            </children>
                        </flow-layout>

                        <stack-layout> <!--Inventory-->
                            <children>
                                <texture texture="betterbadges:textures/gui/badgecase/player_inventory.png"
                                         texture-width="256" texture-height="256"
                                         region-width="176" region-height="102">
                                </texture>
                                <label>
                                    <text>Inventory</text>
                                    <color>#6d4511</color>
                                    <positioning type="relative">8,6</positioning>
                                </label>
                            </children>
                        </stack-layout>
                    </children>
                    <margins>
                        <left>2</left>
                        <top>7</top>
                    </margins>
                </flow-layout >
            </children>

            <surface>
                <vanilla-translucent/>
            </surface>


            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>
            <padding>
                <right>108</right>
            </padding>

        </flow-layout>
    </components>
</owo-ui>